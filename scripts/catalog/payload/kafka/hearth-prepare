#!/bin/bash
# Idempotent KRaft bootstrap. The supervised process is java itself (`java @jvm.args`);
# this script only writes config and formats storage the first time.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA="$1"
PORT="$2"
PORT2="$3"
export JAVA_HOME="$ROOT/jre"
export PATH="$JAVA_HOME/bin:$PATH"
export KAFKA_HEAP_OPTS="-Xms64M -Xmx256M"
KAFKA="$ROOT/kafka"

mkdir -p "$DATA/logs"
cat > "$DATA/server.properties" <<EOF
process.roles=broker,controller
node.id=1
controller.quorum.voters=1@127.0.0.1:${PORT2}
listeners=PLAINTEXT://127.0.0.1:${PORT},CONTROLLER://127.0.0.1:${PORT2}
advertised.listeners=PLAINTEXT://127.0.0.1:${PORT}
inter.broker.listener.name=PLAINTEXT
controller.listener.names=CONTROLLER
listener.security.protocol.map=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
log.dirs=${DATA}/logs
num.partitions=1
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
group.initial.rebalance.delay.ms=0
EOF

if [[ ! -s "$DATA/cluster.id" ]]; then
  "$KAFKA/bin/kafka-storage.sh" random-uuid > "$DATA/cluster.id"
fi
CLUSTER_ID="$(tr -d '[:space:]' < "$DATA/cluster.id")"
if [[ ! -f "$DATA/logs/meta.properties" ]]; then
  "$KAFKA/bin/kafka-storage.sh" format --cluster-id "$CLUSTER_ID" --config "$DATA/server.properties"
fi

cp "$ROOT/kafka/config/hearth-log4j2.xml" "$DATA/log4j2.xml"
{
  printf '%s\n' "-Xms256M" "-Xmx512M" "-Djava.awt.headless=true"
  printf '%s\n' "-Dlog4j2.configurationFile=${DATA}/log4j2.xml"
  printf '%s\n' "-cp"
  first=1
  cp_line=""
  for jar in "$KAFKA"/libs/*.jar; do
    if [[ "$first" -eq 1 ]]; then
      cp_line="$jar"
      first=0
    else
      cp_line="${cp_line}:${jar}"
    fi
  done
  printf '%s\n' "$cp_line"
  printf '%s\n' "kafka.Kafka" "${DATA}/server.properties"
} > "$DATA/jvm.args"
