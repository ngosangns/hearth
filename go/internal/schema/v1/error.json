{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "exit", "message"],
      "properties": {
        "code": {
          "enum": ["failed-generic", "usage", "unavailable", "protocol", "failed", "needs-confirm", "unauthorized", "conflict"]
        },
        "exit": {"type": "integer"},
        "message": {"type": "string"},
        "hint": {"type": "string"}
      }
    }
  }
}
