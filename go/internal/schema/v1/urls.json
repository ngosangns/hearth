{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["urls", "unresolved"],
  "properties": {
    "urls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceId", "url", "requiresRunning", "running"],
        "properties": {
          "serviceId": {"type": "string"},
          "label": {"type": "string"},
          "url": {"type": "string"},
          "requiresRunning": {"type": "boolean"},
          "running": {"type": "boolean"}
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceId", "url", "placeholder"],
        "properties": {
          "serviceId": {"type": "string"},
          "url": {"type": "string"},
          "placeholder": {"type": "string"}
        }
      }
    }
  }
}
