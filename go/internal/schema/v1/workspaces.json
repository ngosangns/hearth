{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspaces"],
  "properties": {
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "trusted", "addedAt"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "trusted": {"type": "boolean"},
          "addedAt": {"type": "string"}
        }
      }
    }
  }
}
