{
  "name": "@gnasdev/local-services",
  "version": "0.7.0",
  "description": "Local dev services manager (daemon, TUI, CLI, MCP) for Bun projects",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnasdev/local-services.git"
  },
  "files": [
    "src",
    "README.md"
  ],
  "bin": {
    "lsd": "./src/bin/lsd.ts"
  },
  "exports": {
    "./core": {
      "types": "./src/core/index.ts",
      "bun": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "bun": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./tui": {
      "types": "./src/tui/index.ts",
      "bun": "./src/tui/index.ts",
      "default": "./src/tui/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "bun": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./node-bridge": {
      "types": "./src/node-bridge/index.ts",
      "bun": "./src/node-bridge/index.ts",
      "default": "./src/node-bridge/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oh-my-pi/pi-tui": "^18.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.7.0"
  }
}
